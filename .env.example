# GitHub OAuth App credentials (required)
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Callback URL for GitHub OAuth (required for production)
# Must match the Authorization callback URL in your GitHub OAuth App settings.
# Defaults to http://localhost:6270/auth/github/callback if not set.
# Examples:
#   GITHUB_REDIRECT_URL=https://yourdomain.com/auth/github/callback
#   GITHUB_REDIRECT_URL=http://localhost:6270/auth/github/callback
GITHUB_REDIRECT_URL=

# Server port (optional, defaults to 6270)
# PORT=6270

# SQLite database path (optional, defaults to gitlens.db)
# DB_PATH=gitlens.db

# GitHub webhook secret (recommended, for verifying webhook payloads)
# GITHUB_WEBHOOK_SECRET=

# Forgejo OAuth2 credentials (optional — omit for GitHub-only deployments)
# Create an OAuth2 application in your Forgejo instance Settings -> Applications.
# FORGEJO_CLIENT_ID=
# FORGEJO_CLIENT_SECRET=

# Forgejo callback URL (optional, defaults to <APP_URL>/auth/forgejo/callback)
# FORGEJO_REDIRECT_URL=https://yourdomain.com/auth/forgejo/callback

# Default Forgejo instance base URL (optional, skip the instance prompt on login)
# Example: FORGEJO_DEFAULT_URL=https://codeberg.org
# FORGEJO_DEFAULT_URL=

# Release → Docker deploy (optional)
# On a GitHub release webhook, GitLens can pull a new Docker image and restart
# the matching container. Requires DEPLOY_TARGETS (or DEPLOY_TARGETS_FILE) to
# map repositories to images and containers. The host must have the Docker CLI
# installed and the GitLens process must have access to the Docker socket.

# JSON array of deploy targets:
#   repository:   GitHub "owner/repo" full name (required)
#   image:        Docker image to pull (required)
#   container:    Docker container to recreate (required)
#   tag_strategy: "release_tag" (default, strips leading "v") or "latest"
# Example:
#   DEPLOY_TARGETS=[{"repository":"martynvdijke/gitlens","image":"ghcr.io/martynvdijke/gitlens","container":"gitlens","tag_strategy":"release_tag"}]
# DEPLOY_TARGETS=
# DEPLOY_TARGETS_FILE=/path/to/targets.json

# Container label auto-discovery (alternative to DEPLOY_TARGETS):
# Any running Docker container with the label gitlens.deploy.target=owner/repo
# is automatically added as a deploy target. The image name and container name
# are inferred from the container's runtime config. Explicit DEPLOY_TARGETS
# always override discovered targets for the same repository.
# Example docker-compose.yml:
#   services:
#     gitlens:
#       labels:
#         gitlens.deploy.target: "martynvdijke/gitlens"

# Deploy backend: "api" (default) or "compose"
#   api:     docker pull + stop/rm/create/start. The container's runtime config
#            (env, volumes, ports, networks, labels, restart policy) is read from
#            `docker inspect` and preserved on recreate.
#   compose: docker compose pull + up -d --no-deps. The compose project is
#            resolved from the container's com.docker.compose.* labels, so the
#            right project directory is used automatically.
# DEPLOY_BACKEND=api

# Helper image used for self-updates and compose-backed deploys (optional).
# Deploys that replace the GitLens container itself (or that need to survive a
# target recreation) are executed inside a short-lived detached helper container
# that talks to the Docker socket and then exits. Defaults to the image the
# running GitLens container was created from.
# DEPLOY_HELPER_IMAGE=ghcr.io/martynvdijke/gitlens:latest

# Allow prerelease publishes to trigger a deploy (default: false)
# DEPLOY_ALLOW_PRERELEASE=false

# Gotify push notification (optional)
# When configured, deploy success/failure is sent as a Gotify message.
# GOTIFY_URL=http://gotify:8080
# GOTIFY_TOKEN=

# OIDC SSO via Authelia (optional — primary web login when configured)
# When OIDC is enabled it becomes the primary web login; GitHub/Forgejo OAuth
# remain available as fallbacks. OIDC users can store GitHub/Forgejo personal
# access tokens in Settings for repository sync and API access.
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=https://authelia.vandijke.xyz
# OIDC_CLIENT_ID=gitlens
# OIDC_CLIENT_SECRET= # or OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_REDIRECT_URL=https://gitlens.vandijke.xyz/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile groups
# OIDC_LOGOUT_URL=https://authelia.vandijke.xyz/logout
# SESSION_SECRET= # HMAC key for OIDC session cookie; defaults to derived from OIDC_CLIENT_SECRET

# Legal pages (optional, but set these before publishing the Android app)
# LEGAL_CONTROLLER_NAME names the GDPR controller on /privacy, /terms and
# /account/delete. Empty falls back to "the operator of this GitLens instance".
# LEGAL_CONTACT_EMAIL adds a mailto: contact and the email fallback on the
# deletion page. Empty removes both rather than inventing an address.
# LEGAL_CONTACT_ADDRESS is optional; a postal address is good practice.
# LEGAL_HOSTING_REGION describes where the server runs, for the transfer
# paragraph. Empty falls back to "the European Union".
# LEGAL_CONTROLLER_NAME="Example B.V."
# LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_CONTACT_ADDRESS="1 Example Street, 1000 AA Amsterdam"
# LEGAL_HOSTING_REGION="the Netherlands"

# Shared demo account (optional)
# Provides a public "Try the demo" login with synthetic sample repositories,
# intended for Google Play review. The account is always non-admin and can
# never become the only administrator.
#
# When DEMO_USER_ENABLED is unset, the demo is enabled only if APP_URL parses
# and its hostname is gitlens.vandijke.xyz (the canonical instance). Set it to
# true explicitly to enable the demo on any other host, e.g. for Play review.
# Demo is disabled on local/self-hosted instances by default.
# DEMO_USER_ENABLED=true
#
# APP_URL is used for the host check above (and OAuth callback defaults).
# APP_URL=https://gitlens.vandijke.xyz
#
# Login shown to reviewers. Defaults to "demo".
# DEMO_USER_LOGIN=demo
#
# Bearer token for API access. This token is intentionally public and
# deterministic so reviewers need no secrets; only its SHA-256 hash is stored
# in the database. Treat the account as read-only-ish sample data, never as a
# place for real credentials or private repositories.
# DEMO_USER_TOKEN=glt_demo_public_preview_2026
